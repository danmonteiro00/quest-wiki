# Sem DATABASE_URL o projeto usa um Postgres local embutido (PGlite) em .data/pglite.
# Em producao, cole aqui a connection string do Neon.
# DATABASE_URL=postgresql://usuario:senha@host.neon.tech/neondb?sslmode=require

# Porta da API em desenvolvimento
PORT=3001

# Senha da tela de edicao do mapa (/mapa/admin). Sem ela, a edicao fica desligada.
# ADMIN_PASSWORD=escolha-uma-senha-longa
